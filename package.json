{
  "name": "desert-dogs-ops",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Bilingual (AR-first) open-source field-ops site for volunteers feeding, watering and rescuing desert dogs in Safawi (Mafraq) and Dhulail (Zarqa), Jordan.",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
